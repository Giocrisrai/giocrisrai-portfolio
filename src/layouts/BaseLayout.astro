---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Giocrisrai Godoy | AI Engineer — LLM Security & Assurance",
  description = "AI Engineer & founder specializing in LLM security & assurance (OWASP LLM Top 10), AI agents, computer vision for robotics, and production-grade ML pipelines. Based in Puerto Montt, Chile — working with clients across Chile, LATAM and globally (remote). Ingeniero de IA: seguridad de agentes LLM, visión por computador y MLOps."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Giocrisrai Godoy Bonillo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="https://giocrisrai.com/images/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://giocrisrai.com/images/og-image.png" />
    <meta name="twitter:creator" content="@Giocrisrai" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="antialiased">
    <a href="#hero" class="sr-only focus:not-sr-only focus:fixed focus:top-0 focus:left-0 focus:z-[100] focus:px-4 focus:py-2 focus:bg-[var(--color-accent)] focus:text-[var(--color-bg-primary)] focus:font-semibold">
      Skip to main content
    </a>
    <slot />
  </body>
</html>
