---

<section id="about" class="py-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">What I Bring</h2>
      <p class="text-[var(--color-text-secondary)] max-w-2xl mx-auto text-lg">
        End-to-end AI engineering across research, industry, and education. From LLM agents and generative AI to computer vision and scalable pipelines — complete systems that solve real problems.
      </p>
    </div>
    <div class="grid md:grid-cols-2 gap-6">
      {blocks.map(block => (
        <div class="p-6 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-card)] hover:border-[var(--color-accent)]/50 transition-colors group">
          <div class="text-[var(--color-accent)] mb-4" set:html={block.icon} />
          <h3 class="text-xl font-semibold mb-3">{block.title}</h3>
          <p class="text-[var(--color-text-secondary)] mb-4 leading-relaxed">{block.description}</p>
          <div class="flex flex-wrap gap-2">
            {block.tags.map(tag => (
              <span class="text-xs px-2.5 py-1 rounded-full bg-[var(--color-bg-primary)] text-[var(--color-text-muted)] border border-[var(--color-border)]">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
