---
const navLinks = [
  { label: "About", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Experience", href: "#experience" },
  { label: "Education", href: "#education" },
  { label: "Contact", href: "#contact" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[var(--color-bg-primary)]/80 backdrop-blur-md border-b border-[var(--color-border)]/50">
  <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="#" class="text-xl font-bold text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors">
      GG
    </a>
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <button id="menu-toggle" class="md:hidden text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors" aria-label="Toggle menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>
  <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--color-border)]/50 bg-[var(--color-bg-primary)]/95 backdrop-blur-md">
    <ul class="px-6 py-4 space-y-4">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class="block text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors mobile-link">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');
  toggle?.addEventListener('click', () => { menu?.classList.toggle('hidden'); });
  mobileLinks.forEach(link => { link.addEventListener('click', () => { menu?.classList.add('hidden'); }); });
</script>
