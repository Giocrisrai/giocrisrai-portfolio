      </p>
    </div>
    <div class="space-y-6">
      {projects.map(project => (
        <div class="p-6 sm:p-8 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-card)] hover:border-[var(--color-accent)]/50 transition-colors group">
